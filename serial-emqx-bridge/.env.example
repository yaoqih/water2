SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
SERIAL_DRY_RUN=0
SERIAL_SAMPLE=BG,TEMP:+00238,ZD:00695,XFW:02524,COD:00972,AD:01982,JY:03299,ED
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=water/serial/v1/telemetry
MQTT_CLIENT_ID=serial-emqx-bridge
MQTT_QOS=1
