[Unit]
Description=Serial water quality bridge to EMQX
After=network-online.target
Wants=network-online.target

[Service]
User=serial-emqx
Group=dialout
WorkingDirectory=/opt/serial-emqx-bridge
EnvironmentFile=/etc/serial-emqx-bridge.env
ExecStart=/usr/bin/python3 -m serial_emqx_bridge
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
